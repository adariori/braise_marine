{
  "builds": [
    { "src": "backend/api/router.php", "use": "vercel-php@0.7.3" },
    { "src": "frontend/includes/index.php", "use": "vercel-php@0.7.3" },
    { "src": "frontend/includes/commande.php", "use": "vercel-php@0.7.3" },
    { "src": "frontend/includes/login.php", "use": "vercel-php@0.7.3" },
    { "src": "frontend/includes/admin.php", "use": "vercel-php@0.7.3" },
    { "src": "frontend/assets/**", "use": "@vercel/static" },
    { "src": "backend/uploads/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "^/$", "dest": "/frontend/includes/index.php", "status": 302 },
    { "src": "^/admin$", "dest": "/frontend/includes/admin.php", "status": 302 },
    { "src": "^/login$", "dest": "/frontend/includes/login.php", "status": 302 },
    { "src": "^/commande$", "dest": "/frontend/includes/commande.php", "status": 302 },
    { "src": "^/backend/api/([a-zA-Z_]+)\\.php$", "dest": "/backend/api/router.php?file=$1" },
    { "src": "^/(.*)$", "dest": "/$1" }
  ]
}
